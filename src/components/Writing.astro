---
// Home page list of blog posts; posts come from src/content/writing (newest first).
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

interface Props {
  posts: CollectionEntry<"writing">[];
}
const { posts } = Astro.props;
const monthYear = (date: Date) => date.toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });
---

<section class="writing section" id="writing">
  <div class="wrap">
    <h2 class="h2" data-reveal>Writing</h2>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li data-reveal>
            <a href={`/writing/${post.id}.html`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
              <span class="meta">{monthYear(post.data.date)} · {post.data.readMinutes} min read</span>
              <Icon name="arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
