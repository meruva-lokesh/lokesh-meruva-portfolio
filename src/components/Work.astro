---
import { site, projects } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="work section" id="work">
  <div class="wrap">
    <h2 class="h2" data-reveal>Selected work</h2>
    <div class="work-list">
      {
        projects.map((p, i) => (
          <article class="work-card" style={`--i: ${i}`}>
            <div class="work-text">
              <h3>
                <a href={p.url} target="_blank" rel="noopener">
                  {p.title}
                </a>
              </h3>
              <p>{p.description}</p>
              <ul class="tags">
                {p.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <a class="text-link" href={p.url} target="_blank" rel="noopener">
                View on GitHub
                <Icon name="arrow" />
              </a>
            </div>
            <picture class="work-img">
              <source srcset={`/assets/images/lokesh/${p.image}.webp`} type="image/webp" />
              <img src={`/assets/images/lokesh/${p.image}.jpg`} alt={p.alt} width="765" height="440" loading="lazy" decoding="async" />
            </picture>
          </article>
        ))
      }
    </div>
    <p class="more" data-reveal>
      <a class="text-link" href={site.links.github} target="_blank" rel="noopener">
        More projects on GitHub
        <Icon name="arrow" />
      </a>
    </p>
  </div>
</section>
