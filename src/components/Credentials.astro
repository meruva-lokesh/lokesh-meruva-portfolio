---
import { credentials } from "../data/site";
---

<section class="creds section" id="achievements">
  <div class="wrap creds-grid">
    <h2 class="h2" data-reveal>{credentials.heading}</h2>
    <ol class="cred-list">
      {
        credentials.items.map((c) => (
          <li data-reveal>
            <span class="when">{c.when}</span>
            <div>
              <h3>{c.title}</h3>
              <p>{c.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
