---
// One page per Markdown file in src/content/writing, at /writing/<file-name>.html
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Sprite from "../../components/Sprite.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("writing");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const path = `/writing/${post.id}.html`;
const published = d.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  datePublished: d.date.toISOString().slice(0, 10),
  image: site.url + d.image,
  mainEntityOfPage: site.url + path,
  author: { "@type": "Person", name: site.name, url: `${site.url}/` },
};
---

<Base
  title={`${d.title} | ${site.name}`}
  description={d.description}
  path={path}
  ogType="article"
  ogTitle={d.title}
  ogDescription={d.ogDescription}
  ogImage={d.image}
  jsonLd={jsonLd}
>
  <Sprite only={["arrow", "back"]} />
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header is-scrolled">
    <div class="wrap header-row">
      <a class="logo" href="/" aria-label={`${site.name}, home`}>Lokesh<span>.</span></a>
      <a class="text-link" href="/#writing"><Icon name="back" />All writing</a>
    </div>
  </header>

  <main id="main" class="article wrap">
    <header class="article-head">
      <h1>{d.title}</h1>
      <p class="meta">{published} · {d.readMinutes} min read</p>
    </header>

    <div class="article-body">
      <Content />
    </div>

    <footer class="article-foot">
      <a class="text-link" href="/#writing"><Icon name="back" />All writing</a>
      <a class="text-link" href={d.repo} target="_blank" rel="noopener">See the code on GitHub<Icon name="arrow" /></a>
    </footer>
  </main>
</Base>
