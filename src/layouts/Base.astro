---
// Shared page shell: <head> (SEO tags, fonts, styles) and <body>. Each page passes its own header and content.
import "../styles/site.css";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  path?: string; // page address for canonical and og:url, e.g. "/writing/name.html"; leave out on the 404 page
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string; // path under the site, e.g. "/assets/images/lokesh/og-card.jpg"
  ogImageMeta?: boolean; // size and alt tags, for the 1200 x 630 link-preview card
  noindex?: boolean;
  jsonLd?: object; // schema.org data for search engines
}

const { title, description, path, ogType, ogTitle, ogDescription, ogImage, ogImageMeta, noindex, jsonLd } = Astro.props;
const url = path === undefined ? undefined : site.url + path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {description && <meta name="description" content={description} />}
    {url && <link rel="canonical" href={url} />}
    <meta name="theme-color" content="#f4f4f2" />
    {
      ogType && (
        <>
          <meta property="og:type" content={ogType} />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:url" content={url} />
          <meta property="og:title" content={ogTitle} />
          <meta property="og:description" content={ogDescription} />
          <meta property="og:image" content={site.url + ogImage} />
          {ogImageMeta && (
            <>
              <meta property="og:image:width" content="1200" />
              <meta property="og:image:height" content="630" />
              <meta property="og:image:alt" content={`${site.name}, AI/ML engineer`} />
            </>
          )}
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <link rel="icon" href="/assets/images/lokesh/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Phudu:wght@500..800&display=swap" />
    <slot name="head" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
